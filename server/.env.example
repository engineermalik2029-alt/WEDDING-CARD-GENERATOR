PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Free forever mode is ON by default. It uses local JSON/file storage
# and a local invitation/card generator, so no paid API keys are required.
# Set FREE_MODE=false only when you want to use paid cloud/AI services.
FREE_MODE=true

# Optional paid production services. Leave blank for free local mode.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/wedding-cards
REQUIRE_MONGODB=false
OPENAI_API_KEY=sk-your-openai-key
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret